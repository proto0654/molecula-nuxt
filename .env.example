# WordPress REST API (production CMS on api subdomain)
NUXT_PUBLIC_WP_API_BASE=https://api.weblaba.ru/wp-json

# Public site origin for canonical / OG / sitemap
NUXT_PUBLIC_SITE_URL=https://weblaba.ru

# GitHub Pages preview path only — leave empty or / for local / production
# NUXT_APP_BASE_URL=/molecula-nuxt/

# Set to false on preview builds to block search engine indexing
# NUXT_PUBLIC_INDEXABLE=false
